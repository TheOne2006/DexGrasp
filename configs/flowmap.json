{
  "schema_version": 1,
  "dataset_root": "../../data/dataset_v1",
  "hand_spec": "../../data/dataset_v1/hand/hand_spec.json",
  "device": "cuda:0",
  "precision": "float32",
  "batch_size": 8,
  "accumulation": 1,
  "num_workers": 2,
  "max_steps": 10000,
  "lr": 0.0002,
  "model": {
    "width": 512,
    "depth": 8,
    "heads": 8,
    "tokens": 128,
    "backbone_channels": 512,
    "keypoints": 21,
    "coord_scale_m": 0.2,
    "voxel_size_m": 0.005
  },
  "method": "flowmap",
  "sample_steps": 1,
  "run_dir": "../../outputs/v1/flowmap",
  "checkpoint_dir": "../../checkpoints/v1/flowmap",
  "teacher_checkpoint": "../../checkpoints/v1/fm/best.pt",
  "teacher_steps": 32,
  "teacher_solver": "heun",
  "full_interval_probability": 0.5
}
